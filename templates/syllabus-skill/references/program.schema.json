{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "program", "training_objectives", "graduation_requirements", "indicators", "courses", "course_groups", "relations", "aggregates"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "program": {"$ref": "#/$defs/entity"},
    "training_objectives": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "graduation_requirements": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "indicators": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "courses": {"type": "array", "items": {"$ref": "#/$defs/course"}},
    "course_groups": {"type": "array", "items": {"$ref": "#/$defs/course_group"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "aggregates": {"type": "object"}
  },
  "$defs": {
    "hours": {"type": ["number", "null"], "minimum": 0},
    "entity": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}}, "additionalProperties": true},
    "course": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "hours": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hours"}}}, "additionalProperties": true},
    "course_group": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "course_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "relation": {"type": "object", "required": ["source", "target", "type", "provenance"], "properties": {"source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "provenance": {"$ref": "#/$defs/provenance"}}, "additionalProperties": true},
    "provenance": {"type": "object", "required": ["source_kind", "source_file_hash", "source_page", "source_table", "source_symbol", "verification_status", "note"], "properties": {"source_kind": {"type": "string", "minLength": 1}, "source_file_hash": {"type": "string", "minLength": 1}, "source_page": {"type": "integer", "minimum": 1}, "source_table": {"type": "string", "minLength": 1}, "source_symbol": {"type": "string"}, "verification_status": {"type": "string", "minLength": 1}, "note": {"type": "string"}}, "additionalProperties": true}
  }
}
